# Configuration de la base de données PostgreSQL
# Le chemin est sur le disque de l'utilisateur, jamais codé en dur dans le code.
DATABASE_URL=postgresql+psycopg://<utilisateur>@localhost:5432/<nom_base_de_donnees>

# Clé secrète pour la signature des tokens JWT (à générer, au moins 32 caractères)
SECRET_KEY=<remplacer-par-une-cle-secrete-unique>

# Durée de validité des tokens d'accès (en minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origines autorisées par le CORS (frontend)
CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# Stockage des documents importés (relatif au dossier backend ou absolu ; jamais commité)
DOCUMENT_STORAGE_PATH=./data/documents
# OCR hors ligne (Apple Vision) : swiftc -O tools/ocr_vision.swift -o bin/ocr-vision
OCR_COMMAND=./bin/ocr-vision
# Taille maximale d'un document importé (Mo)
MAX_UPLOAD_MB=200
